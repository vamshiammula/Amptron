# Copy to .env and fill in the values. Never commit .env.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL, from Supabase Dashboard > Project Settings > Data API.
SUPABASE_URL=https://your-project.supabase.co

# Preferred. Bypasses RLS, so it can also read applications back for the admin
# endpoint. Server-side only: never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fallback when no service-role key is available. The dealer_applications RLS
# policy grants INSERT only, so this key can submit but never read.
SUPABASE_PUBLISHABLE_KEY=

# Use `memory` to run the API without any credentials (E2E tests, demos).
# Nothing is persisted. Anything else uses Supabase.
APPLICATIONS_STORE=supabase

# Upload scooter photos/videos and seed models + blogs after the schema exists:
# npm run sync:content

# ---------------------------------------------------------------------------
# FAQ assistant (Cloudflare Workers AI embeddings, Free plan only)
# ---------------------------------------------------------------------------
# Account ID from Workers AI > Use REST API. Token needs Workers AI Read + Edit.
# Stay on Workers Free: overage fails instead of billing.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# FAQ_MIN_SIMILARITY=0.58
# FAQ_MIN_MARGIN=0.04

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Salt for the SHA-256 IP hash stored with each application. When unset, no IP
# is recorded at all. Generate with: openssl rand -hex 24
IP_HASH_SALT=

# Enables GET /api/applications via the x-admin-key header. The endpoint
# returns 404 while this is unset. Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Submissions allowed per IP per window.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=10

# Set to true only once the site is served exclusively over HTTPS. It adds the
# upgrade-insecure-requests CSP directive, which breaks plain-HTTP origins.
CSP_UPGRADE_INSECURE_REQUESTS=false

# Only needed when the browser app is hosted on a different origin than the API.
# Comma-separated, e.g. https://amptron.co.in,https://www.amptron.co.in
CORS_ORIGINS=

# Serve the built client from Express. Defaults to true when NODE_ENV=production.
# SERVE_STATIC=true

# ---------------------------------------------------------------------------
# Client (Vite, must be prefixed with VITE_)
# ---------------------------------------------------------------------------
# Leave empty to call the API on the same origin, which is what the dev proxy
# and the production server both provide.
# VITE_API_BASE_URL=

# Required for dealer/admin login in the web portal.
# Use your project's publishable (anon) key for browser auth.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=
